# Variáveis do ambiente de desenvolvimento local (docker compose)
# Copie para .env e ajuste se necessário: cp .env.example .env
# Sem o .env, o docker-compose.yml usa estes mesmos valores como padrão.

# Banco de dados PostgreSQL
POSTGRES_USER=duoc
POSTGRES_PASSWORD=duoc
POSTGRES_DB=duoc_finance

# Porta do PostgreSQL exposta na máquina local (altere se a 5432 já estiver em uso)
POSTGRES_PORT=5432
