// Schema do banco de dados do DUOC Finance
// Documentação: https://pris.ly/d/prisma-schema
//
// Depois de alterar este arquivo, gere uma migration com:
//   docker compose exec backend npx prisma migrate dev --name <descricao>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// CAR-02 · Apontamento de Campo (RVT)
// ---------------------------------------------------------------------------

enum StatusContratoObra {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum StatusRvt {
  PENDENTE
  HOMOLOGADO
  REJEITADO
}

// Contrato de obra ao qual todo apontamento deve estar vinculado (RN04).
// O cadastro completo de contratos pertence a outra história; aqui ficam
// apenas os campos necessários para o vínculo do RVT.
model ContratoObra {
  id        String             @id @default(uuid())
  codigo    String             @unique
  nome      String
  cliente   String?
  status    StatusContratoObra @default(ATIVO)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  apontamentos Rvt[]

  @@map("contratos_obra")
}

// Registro de Visita Técnica / apontamento diário de campo (RF04)
model Rvt {
  id               String    @id @default(uuid())
  // Identificador do colaborador extraído do JWT. Ainda sem FK porque o
  // model de colaboradores não existe no banco.
  colaboradorId    String    @map("colaborador_id")
  contratoId       String    @map("contrato_id")
  dataJornada      DateTime  @map("data_jornada") @db.Date
  horasTrabalhadas Decimal   @map("horas_trabalhadas") @db.Decimal(4, 2)
  escopoExecutado  String    @map("escopo_executado")
  status           StatusRvt @default(PENDENTE)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  contrato   ContratoObra   @relation(fields: [contratoId], references: [id])
  evidencias RvtEvidencia[]

  @@index([colaboradorId, dataJornada])
  @@map("rvts")
}

// Arquivo comprobatório (foto ou PDF) anexado ao RVT (RN06, RNF19)
model RvtEvidencia {
  id             String   @id @default(uuid())
  rvtId          String   @map("rvt_id")
  nomeOriginal   String   @map("nome_original")
  mimeType       String   @map("mime_type")
  tamanhoBytes   Int      @map("tamanho_bytes")
  hashSha256     String   @map("hash_sha256")
  caminhoArquivo String   @map("caminho_arquivo")
  createdAt      DateTime @default(now()) @map("created_at")

  rvt Rvt @relation(fields: [rvtId], references: [id], onDelete: Cascade)

  @@index([rvtId])
  @@map("rvt_evidencias")
}

// ---------------------------------------------------------------------------
// CAR-07 · Controle de acesso e sessões (issue #155)
// O vínculo com o cadastro de colaboradores será integrado separadamente.
// ---------------------------------------------------------------------------

enum PapelUsuario {
  ADMIN_SISTEMA
  ADMIN_FINANCEIRO
  GESTOR_OBRAS
  TECNICO_CAMPO
}

model Usuario {
  id                String       @id @default(uuid())
  email             String       @unique @db.VarChar(254)
  senhaHash         String       @map("senha_hash") @db.VarChar(255)
  papel             PapelUsuario
  ativo             Boolean      @default(true)
  senhaAtualizadaEm DateTime     @default(now()) @map("senha_atualizada_em")
  // RF23 — estado persistente de bloqueio após cinco falhas consecutivas.
  tentativasFalhas  Int          @default(0) @map("tentativas_falhas")
  bloqueadoAte      DateTime?    @map("bloqueado_ate")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  sessoes           Sessao[]
  eventosOperados   EventoAcesso[] @relation("EventosOperados")
  eventosRecebidos  EventoAcesso[] @relation("EventosRecebidos")

  @@map("usuarios")
}

enum AcaoAcesso {
  PAPEL_ALTERADO
  CONTA_ATIVADA
  CONTA_DESATIVADA
}

model EventoAcesso {
  id            String     @id @default(uuid())
  operadorId    String     @map("operador_id")
  usuarioId     String     @map("usuario_id")
  acao          AcaoAcesso
  papelAnterior PapelUsuario? @map("papel_anterior")
  papelNovo     PapelUsuario? @map("papel_novo")
  ativoAnterior Boolean?   @map("ativo_anterior")
  ativoNovo     Boolean?   @map("ativo_novo")
  ocorridoEm    DateTime   @default(now()) @map("ocorrido_em")

  operador Usuario @relation("EventosOperados", fields: [operadorId], references: [id], onDelete: Restrict)
  usuario  Usuario @relation("EventosRecebidos", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, ocorridoEm])
  @@index([operadorId, ocorridoEm])
  @@map("eventos_acesso")
}

model Sessao {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  criadaEm   DateTime  @default(now()) @map("criada_em")
  expiraEm   DateTime  @map("expira_em")
  revogadaEm DateTime? @map("revogada_em")
  refreshTokenHash String? @unique @map("refresh_token_hash") @db.VarChar(64)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revogadaEm])
  @@map("sessoes")
}
